# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Redis connection -------------------------------------------------------
# Full connection string (takes precedence over the REDIS_* parts below)
REDIS_URL=redis://127.0.0.1:6379

# Or build the URL from parts (used only when REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Socket/connect timeouts in ms
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000

# Key namespace so this app never collides with anything else in the DB
REDIS_KEY_PREFIX=testbed

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# --- Worker -----------------------------------------------------------------
# How many jobs a single worker process handles at the same time
WORKER_CONCURRENCY=2
# A worker is considered "offline" if it has not checked in for this long (ms)
WORKER_STALE_MS=15000
# A job is considered "stuck" if it has been running longer than this (ms)
JOB_TIMEOUT_MS=60000
# Simulated work duration range in ms for the built-in test tasks
TASK_MIN_MS=400
TASK_MAX_MS=2500
